rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && data != null && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- CORE RULES --

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        // HIERARCHICAL ACCESS:
        // 1. Admins see everything.
        // 2. Team Leads & Executives see only leads assigned to them.
        allow read: if isMember(teamspaceId) && (isAdmin() || request.auth.uid in resource.data.assignedToIds);
        
        // WRITE PERMISSIONS:
        // 1. Admins can do anything.
        // 2. Team Leads can edit and delegate leads they are assigned to.
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          (getUserData().role == 'sales_team_lead' && (resource == null || request.auth.uid in resource.data.assignedToIds))
        );
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}
