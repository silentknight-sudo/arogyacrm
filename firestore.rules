rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      // HIGH-RESILIENCY FAIL-SAFE: Priority email check ensures leadership never loses access
      // Token-based check bypasses Firestore document-load race conditions
      return isSignedIn() && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isMember(teamspaceId) {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         teamspaceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamspaceIds)
      );
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'none';
    }

    // -- GLOBAL EXECUTIVE OVERRIDE --
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // -- CORE RULES --

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (getUserRole() == 'sales_team_lead' && (
            resource == null || resource.data.createdBy == request.auth.uid
        ))
      );
      
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);

      match /leads/{leadId} {
        allow list, get: if isAdmin() || isMember(teamspaceId);
        allow write: if isAdmin() || (isMember(teamspaceId) && (
          (getUserRole() == 'sales_team_lead') || 
          (resource != null && request.auth.uid in resource.data.assignedToIds) ||
          (resource == null) 
        ));
      }

      match /deals/{dealId} {
        allow list, get: if isAdmin() || isMember(teamspaceId);
        allow write: if isAdmin() || (isMember(teamspaceId) && (
          (getUserRole() == 'sales_team_lead') ||
          (resource != null && request.auth.uid in resource.data.assignedToIds) ||
          (resource == null)
        ));
      }

      match /{allPaths=**} {
        allow read, write: if isAdmin() || isMember(teamspaceId);
      }
    }
  }
}