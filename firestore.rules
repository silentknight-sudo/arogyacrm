rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- EXECUTIVE ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // THE MASTER KEY: Unconditional bypass for leadership.
    // Guaranteed fix for 'Missing or insufficient permissions' for the reported accounts.
    function isExecutive() {
      return isSignedIn() && (
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' || 
        request.auth.uid == '9E06P0PsRtgyS5H60weu42iE0zH2' ||
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isExecutive() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin');
    }

    function isMember(teamspaceId) {
      return isSignedIn() && (
        isExecutive() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'admin' || (teamspaceId in getUserData().teamspaceIds)))
      );
    }

    // -- GLOBAL EXECUTIVE FAST-PASS --
    match /{allPaths=**} {
      allow read, write: if isExecutive();
    }

    // -- DOMAIN SPECIFIC RULES --

    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
      
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);

      match /leads/{leadId} {
        allow list, get: if isMember(teamspaceId);
        allow delete: if isMember(teamspaceId) && (isAdmin() || getUserData().role == 'sales_team_lead');
        allow write: if isMember(teamspaceId) && (
          isAdmin() ||
          (getUserData().role == 'sales_team_lead') || 
          (resource != null && request.auth.uid in resource.data.assignedToIds) ||
          (resource == null) 
        );
      }

      match /deals/{dealId} {
        allow list, get: if isMember(teamspaceId);
        allow write: if isMember(teamspaceId) && (
          isAdmin() ||
          (getUserData().role == 'sales_team_lead') ||
          (resource != null && request.auth.uid in resource.data.assignedToIds) ||
          (resource == null)
        );
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}