rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ROBUST HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isMember(teamspaceId) {
      return isSignedIn() && (
        isAdmin() || 
        teamspaceId in getUserData().teamspaceIds
      );
    }

    // -- RULES --

    // User Directory: Allow all staff to see names/roles for assignment dropdowns
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Global Catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isRole('support');
    }

    // Teamspace Scoped Data
    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      // STRICT LEADS: Assignment-based access for Executives
      match /leads/{leadId} {
        allow read, write: if isAdmin() || isRole('sales_team_lead') || isRole('marketer');
        allow read, write: if isRole('sales_executive') && 
                             isMember(teamspaceId) && 
                             (resource == null || request.auth.uid in resource.data.assignedToIds);
      }

      // Catch-all for other subcollections
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}