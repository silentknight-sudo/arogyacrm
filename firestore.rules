rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --

    function isSignedIn() {
      return request.auth != null;
    }

    // Resilient check for admin role
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Resilient check for teamspace membership
    function isMember(teamspaceId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && (
        isAdmin() || 
        (userDoc != null && teamspaceId in userDoc.data.teamspaceIds)
      );
    }

    // -- Collection Rules --

    // User Profiles: All signed-in staff must be able to list/read profiles for assignments
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Products: Global catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspaces and nested CRM data
    match /teamspaces/{teamspaceId} {
      // Direct access to the teamspace metadata
      allow get: if isMember(teamspaceId);
      allow list: if isAdmin();
      allow write: if isAdmin();

      // PROTECT ALL NESTED DATA (leads, deals, tasks, invoices, etc.)
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}
