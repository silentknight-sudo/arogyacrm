rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper to get user profile data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Resilient check for admin role
    function isAdmin() {
      if (!isSignedIn()) return false;
      // Priority 1: Check token (fastest)
      if (request.auth.token.role == 'admin') return true;
      // Priority 2: Fallback to document check
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && get(path).data.role == 'admin';
    }

    // Resilient check for teamspace membership
    function isTeamspaceMember(teamspaceId) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;
      
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && 
             teamspaceId in get(path).data.teamspaceIds;
    }

    // -- Collection Rules --

    // User Profiles: Required for directory lookups and assignments
    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Global Products catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspace Scoped Data
    match /teamspaces/{teamspaceId} {
      allow get: if isTeamspaceMember(teamspaceId);
      allow list: if isTeamspaceMember(teamspaceId);
      allow write: if isAdmin();

      // SPECIFIC RULES FOR LEADS (Assignment-based access)
      match /leads/{leadId} {
        allow read, write: if isAdmin();
        
        // Executives only see/edit their assigned leads. 
        // Team Leads and Marketers can see all leads in their teamspace.
        allow read, write: if isTeamspaceMember(teamspaceId) && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['sales_team_lead', 'marketer', 'admin']) ||
          (resource != null && request.auth.uid in resource.data.assignedToIds) ||
          (resource == null && request.auth.uid in request.resource.data.assignedToIds)
        );
      }

      // PROTECT ALL OTHER NESTED DATA (deals, tasks, invoices, etc.)
      match /{allPaths=**} {
        allow read, write: if isTeamspaceMember(teamspaceId);
      }
    }
  }
}