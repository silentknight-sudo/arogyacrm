rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && data != null && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- CORE RULES --

    match /users/{userId} {
      // Admins read everyone. TLs read users who are in their teamspaces.
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (getUserData().role == 'sales_team_lead' && get(/databases/$(database)/documents/users/$(userId)).data.teamspaceIds.hasAny(getUserData().teamspaceIds))
      );
      
      // Admin can write anyone. TL can create only if they follow restrictions (handled in actions, but rules protect).
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        // VISIBILITY:
        // 1. Admins see everything in workspace.
        // 2. TLs see everything in their workspace.
        // 3. Executives see only leads assigned to them.
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          request.auth.uid in resource.data.assignedToIds
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          request.auth.uid in resource.data.assignedToIds
        );
      }

      match /deals/{dealId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          resource.data.ownerId == request.auth.uid
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          resource.data.ownerId == request.auth.uid
        );
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}
