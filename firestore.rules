rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && data != null && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- COLLECTION GROUP RULES (Required for Admin Global Dashboard) --
    
    match /{path=**}/leads/{leadId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/deals/{dealId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/contacts/{contactId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/activityLogs/{logId} {
      allow read: if isAdmin();
    }

    // -- CORE RULES --

    match /users/{userId} {
      // Admins read everyone. 
      // TLs read specialists who share a teamspace.
      // Individuals read themselves.
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (getUserData().role == 'sales_team_lead' && (
            resource == null || resource.data.teamspaceIds.hasAny(getUserData().teamspaceIds)
        ))
      );
      
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          request.auth.uid in resource.data.assignedToIds
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          request.auth.uid in resource.data.assignedToIds
        );
      }

      match /deals/{dealId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          resource.data.ownerId == request.auth.uid
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          resource.data.ownerId == request.auth.uid
        );
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}
