rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ROBUST HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function isRole(role) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == role;
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && data != null && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- RULES --

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isRole('support');
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        // Higher roles get full access
        allow read, write: if isAdmin() || isRole('sales_team_lead') || isRole('marketer');
        
        // Executives only see leads assigned to them
        allow read, write: if isRole('sales_executive') && 
                             isMember(teamspaceId) && 
                             (resource == null || (resource.data.assignedToIds != null && request.auth.uid in resource.data.assignedToIds));
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}