rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return userExists() ? getUserDoc().data : null;
    }

    function isAdmin() {
      // MASTER OVERRIDE: Check for the admin email in the token first for high-velocity access.
      // Then fallback to the document-based role check.
      return isSignedIn() && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        (userExists() && getUserDoc().data.role == 'admin')
      );
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && (
        isAdmin() || 
        (data != null && data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- GLOBAL ADMIN OVERRIDE --
    // This is the "Fast-Pass" that ensures admins have guaranteed access to all resources.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // -- CORE RULES --

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (userExists() && getUserData().role == 'sales_team_lead' && (
            resource == null || resource.data.createdBy == request.auth.uid
        ))
      );
      
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      // Member Access: View teamspace metadata
      allow get, list: if isMember(teamspaceId);

      // Specific Lead Logic: Enforces assignment privacy for Sales Executives
      match /leads/{leadId} {
        allow read, write: if isAdmin() || (isMember(teamspaceId) && (
          (userExists() && getUserData().role == 'sales_team_lead') || 
          (resource != null && request.auth.uid in resource.data.assignedToIds) ||
          (resource == null) // Allow creation if they are a member
        ));
      }

      // Specific Deal Logic: Enforces management hierarchy
      match /deals/{dealId} {
        allow read, write: if isAdmin() || (isMember(teamspaceId) && (
          (resource != null && (
            resource.data.teamLeadId == request.auth.uid || 
            resource.data.ownerId == request.auth.uid
          )) ||
          (resource == null) // Allow creation
        ));
      }

      // Recursive Member Override: Members can access other sub-collections
      match /{allPaths=**} {
        allow read, write: if isAdmin() || isMember(teamspaceId);
      }
    }
  }
}