rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- EXECUTIVE IDENTITY MASTER-KEY --
    // Validated directly from the Auth Token to ensure zero-latency authority.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.uid == '9E06P0PsRtgyS5H60weu42iE0zH2'
      );
    }

    // 🛡️ THE ABSOLUTE BYPASS 🛡️
    // This rule short-circuits evaluation for administrators, ignoring all path-specific locks.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // -- PROTECTED COLLECTIONS --

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      function isMember() {
        return request.auth != null && (
          isAdmin() || 
          teamspaceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamspaceIds
        );
      }

      // Root access for teamspace metadata
      allow read: if isMember();
      
      // Recursive rule for all sub-modules (leads, deals, tasks, etc.)
      match /{allPaths=**} {
        allow read, write: if isMember();
      }
    }
  }
}