rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- ATOMIC IDENTITY HELPERS --

    function signedIn() {
      return request.auth != null;
    }

    // 🛡️ THE IMMUTABLE EXECUTIVE MASTER-KEY 🛡️
    // Evaluated at the absolute root to ensure zero-latency authority for leadership.
    // Checks UID and Email directly from token metadata to bypass all get() call overhead.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.uid == '9E06P0PsRtgyS5H60weu42iE0zH2'
      );
    }

    // Direct Root Bypass for Administrators
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // -- MEMBERSHIP LOGIC --

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember(teamspaceId) {
      return isAdmin() || (
        signedIn() && 
        getUserData().teamspaceIds != null && 
        teamspaceId in getUserData().teamspaceIds
      );
    }

    // -- PROTECTED COLLECTIONS --

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || userId == request.auth.uid);
      allow write: if isAdmin() || (signedIn() && userId == request.auth.uid);
      
      match /notifications/{id} {
        allow read, write: if signedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow read: if isMember(teamspaceId);
      allow write: if isAdmin();

      // Ensure explicit authority for specific CRM modules
      match /leads/{leadId} {
        allow read, list: if isMember(teamspaceId);
        allow write: if isMember(teamspaceId);
      }
      
      match /deals/{dealId} {
        allow read, list: if isMember(teamspaceId);
        allow write: if isMember(teamspaceId);
      }

      // Recursive catch-all for workspace sub-modules
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}