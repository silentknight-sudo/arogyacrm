rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --

    // Check if the request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Safely check if the user is an admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Check if the user is a member of a specific teamspace
    function isMember(teamspaceId) {
      return isSignedIn() && (
        isAdmin() || 
        teamspaceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamspaceIds
      );
    }

    // -- Collection Rules --

    // User Profiles: All signed-in staff can see profiles for assignment dropdowns
    // This explicit match on the collection path ensures 'list' operations work
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Products: Global catalog readable by all authenticated staff
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspaces and nested data
    match /teamspaces/{teamspaceId} {
      // Direct access to the teamspace document
      allow get: if isMember(teamspaceId);
      
      // Global listing of teamspaces is admin-only
      allow list: if isAdmin();
      
      // Manage teamspaces
      allow create, update, delete: if isAdmin();

      // ALL sub-collections (leads, deals, tasks, etc.)
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}