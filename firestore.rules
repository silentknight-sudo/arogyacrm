rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ UNSTOPPABLE EXECUTIVE MASTER-KEY 🛡️
    // This allows specific users total access, bypassing all document-load race conditions.
    // We check UID and Email directly from the auth token to ensure zero-latency access.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com'
      );
    }

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        getUserData().role == 'admin'
      );
    }

    function isMember(teamspaceId) {
      return isSignedIn() && (
        isAdmin() || 
        (getUserData().teamspaceIds != null && teamspaceId in getUserData().teamspaceIds)
      );
    }

    // -- COLLECTION GROUP RULES (Required for Admin Global Dashboard) --
    
    match /{path=**}/leads/{leadId} {
      allow read, list: if isSignedIn() && (isAdmin() || request.auth.token.email == 'pundhir@arogyabio.com');
    }
    
    match /{path=**}/deals/{dealId} {
      allow read, list: if isSignedIn() && (isAdmin() || request.auth.token.email == 'pundhir@arogyabio.com');
    }

    // -- CORE DOMAIN RULES --

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (getUserData().role == 'sales_team_lead' && (
            resource == null || resource.data.createdBy == request.auth.uid
        ))
      );
      
      allow write: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        allow read, write: if isMember(teamspaceId);
      }

      match /deals/{dealId} {
        allow read, write: if isMember(teamspaceId);
      }

      // Recursive wildcard for other teamspace sub-collections
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}