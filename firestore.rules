rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- EXECUTIVE FAIL-SAFE (TOP PRIORITY) --
    // Bypasses all resource limits and document-load race conditions.
    function isExecutive() {
      return request.auth != null && (
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' || 
        request.auth.uid == '9E06P0PsRtgyS5H60weu42iE0zH2' ||
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com'
      );
    }

    // THE MASTER KEY: Unconditional bypass for leadership.
    match /{allPaths=**} {
      allow read, write: if isExecutive();
    }

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isExecutive() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin');
    }

    function isMember(teamspaceId) {
      return isSignedIn() && (
        isExecutive() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'admin' || (teamspaceId in getUserData().teamspaceIds)))
      );
    }

    // -- COLLECTION GROUP RULES (Required for Global Dashboard) --
    
    match /{path=**}/leads/{leadId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/deals/{dealId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/contacts/{contactId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/activityLogs/{logId} {
      allow read: if isAdmin();
    }

    // -- DOMAIN SPECIFIC RULES --

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'sales_team_lead' && (
            resource == null || resource.data.createdBy == request.auth.uid
         ))
      );
      
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
      
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'sales_team_lead') || 
          request.auth.uid in resource.data.assignedToIds
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'sales_team_lead') || 
          request.auth.uid in resource.data.assignedToIds
        );

        allow delete: if isMember(teamspaceId) && (
          isAdmin() || 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'sales_team_lead')
        );
      }

      match /deals/{dealId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          resource.data.teamLeadId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          resource.data.teamLeadId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid
        );
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}