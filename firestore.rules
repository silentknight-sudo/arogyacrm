rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isTeamLead() {
      return isSignedIn() && getUserData().role == 'sales_team_lead';
    }

    function isTeamspaceMember(teamspaceId) {
      // A user is a member if their user document's teamspaceIds array contains the teamspaceId.
      return isSignedIn() && getUserData().teamspaceIds.hasAny([teamspaceId]);
    }

    // Check if the user is the owner of a specific document
    function isDocOwner(doc) {
      return isOwner(doc.data.ownerId)
          || isOwner(doc.data.assignedToId)
          || isOwner(doc.data.organizerId)
          || isOwner(doc.data.callerId)
          || isOwner(doc.data.uploadedById)
          || isOwner(doc.data.requestedById)
          || isOwner(doc.data.processedById)
          || isOwner(doc.data.userId);
    }
    
    // Check if the user making the request will be the owner of the new document
    function isIncomingDocOwner() {
        return request.resource.data.ownerId == request.auth.uid
            || request.resource.data.assignedToId == request.auth.uid
            || request.resource.data.organizerId == request.auth.uid
            || request.resource.data.callerId == request.auth.uid
            || request.resource.data.uploadedById == request.auth.uid
            || request.resource.data.requestedById == request.auth.uid
            || request.resource.data.processedById == request.auth.uid
            || request.resource.data.userId == request.auth.uid;
    }
    
    // Checks if the user being accessed is in a shared teamspace
    function hasSharedTeamspace(targetUserId) {
      let requestUserTeamspaces = getUserData().teamspaceIds;
      let targetUserTeamspaces = get(/databases/$(database)/documents/users/$(targetUserId)).data.teamspaceIds;
      return requestUserTeamspaces.hasAny(targetUserTeamspaces);
    }
    
    function salesExecAllowedLeadUpdateKeys() {
        return ['status', 'notes', 'priority', 'reasoning', 'score', 'engagementScore', 'lastContacted', 'updatedAt'];
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Users can read their own profile. Admins can read any. 
    // Users can read profiles of teammates in shared teamspaces.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || hasSharedTeamspace(userId);
      allow list: if isAdmin();
      allow create: if isAdmin(); // Only admins can create users
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Products are public to all signed-in users, but only managed by admins
    match /products/{productId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
    }

    // Teamspaces can be created by admins. They can be managed by their owner or an admin.
    // Members can read teamspace details.
    match /teamspaces/{teamspaceId} {
      allow get: if isTeamspaceMember(teamspaceId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || isOwner(resource.data.ownerId);

      // Lead-specific rules for distribution workflow
      match /leads/{leadId} {
        allow get, list: if isTeamspaceMember(teamspaceId) || isAdmin();
        allow create: if (isTeamspaceMember(teamspaceId) || isAdmin()) && request.auth.uid == request.resource.data.assignedToId;
        allow update: if 
            isTeamspaceMember(teamspaceId) && (
                // Admins and Team Leads can update anything
                isAdmin() || isTeamLead() ||
                // The assigned sales executive can only update specific fields
                (request.auth.uid == resource.data.assignedToId && 
                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(salesExecAllowedLeadUpdateKeys()))
            );
        allow delete: if (isTeamspaceMember(teamspaceId) || isAdmin()) && (isDocOwner(resource) || isAdmin() || isTeamLead());
      }

      // Generic rule for all other teamspace subcollections.
      match /{collection}/{docId} {
        allow get, list: if isTeamspaceMember(teamspaceId) || isAdmin();
        allow create: if (isTeamspaceMember(teamspaceId) || isAdmin()) && isIncomingDocOwner();
        allow update, delete: if (isTeamspaceMember(teamspaceId) || isAdmin()) && (isDocOwner(resource) || isAdmin());
      }
    }
  }
}
