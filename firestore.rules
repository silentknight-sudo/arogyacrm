rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- RESILIENT HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getProfile().role == 'admin';
    }

    function isRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getProfile().role == role;
    }

    function isMember(teamspaceId) {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         teamspaceId in getProfile().teamspaceIds)
      );
    }

    // -- RULES --

    // User Directory: Needed for assignment dropdowns
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Global Catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspace Scoped Data
    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      // STRICT LEADS: Assignment-based access for Executives
      match /leads/{leadId} {
        allow read, write: if isAdmin() || isRole('sales_team_lead') || isRole('marketer');
        allow read, write: if isMember(teamspaceId) && 
                             isRole('sales_executive') && 
                             (resource == null || request.auth.uid in resource.data.assignedToIds);
      }

      // Catch-all for other teamspace collections
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}