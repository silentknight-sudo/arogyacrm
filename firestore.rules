rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ INDESTRUCTIBLE EXECUTIVE MASTER-KEY 🛡️
    // This bypass is evaluated first and grants absolute authority to verified leadership.
    // It relies on token metadata (UID/Email) to avoid get() call latency and document race conditions.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com'
      );
    }

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isExecutive() {
      return isSignedIn() && (
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.token.email == 'admin@arogyabio.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isExecutive() || (isSignedIn() && getUserData().role == 'admin');
    }

    function isMember(teamspaceId) {
      if (isExecutive()) return true;
      let data = getUserData();
      return isSignedIn() && (
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- PROTECTED COLLECTIONS --

    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
      
      match /notifications/{id} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      // Direct access for authorized members and executives
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      // Explicit permissions for nested collections to prevent recursive search failures
      match /leads/{id} {
        allow read, write: if isMember(teamspaceId);
      }

      match /deals/{id} {
        allow read, write: if isMember(teamspaceId);
      }

      match /contacts/{id} {
        allow read, write: if isMember(teamspaceId);
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}