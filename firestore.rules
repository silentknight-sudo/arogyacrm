rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ EXECUTIVE MASTER-KEY (Absolute Root Bypass)
    // Validates identity directly from the auth token to ensure zero-latency authority.
    function isExecutive() {
      return request.auth != null && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.uid == '9E06P0PsRtgyS5H60weu42iE0zH2'
      );
    }

    // 🏆 GLOBAL AUTHORITY 🏆
    // This rule short-circuits all evaluation for administrators at the absolute root.
    match /{allPaths=**} {
      allow read, write: if isExecutive();
    }

    // -- PROTECTED PATHS (For Standard Specialists) --

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if request.auth != null;
    }

    match /teamspaces/{teamspaceId} {
      function isMember() {
        return request.auth != null && (
          teamspaceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamspaceIds
        );
      }

      allow read: if isMember();
      
      match /{allPaths=**} {
        allow read, write: if isMember();
      }
    }
  }
}