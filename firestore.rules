rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Resilient check for admin role
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Resilient check for teamspace membership
    function isMember(teamspaceId) {
      if (!isSignedIn()) return false;
      
      // Admin bypass
      if (request.auth.token.role == 'admin') return true;
      
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && 
             userDoc.data != null && 
             userDoc.data.teamspaceIds != null && 
             teamspaceId in userDoc.data.teamspaceIds;
    }

    // -- Collection Rules --

    // User Profiles: Essential for assignment and team lists
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Products: Global catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspaces: Root metadata
    match /teamspaces/{teamspaceId} {
      allow get: if isMember(teamspaceId);
      allow list: if isAdmin();
      allow write: if isAdmin();

      // PROTECT ALL NESTED DATA (leads, deals, tasks, invoices, etc.)
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}