rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --

    // Check if the request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get user profile data (only if document exists)
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user profile exists
    function userProfileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Admin check: Prioritizes token claim, falls back to document check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' || 
        (userProfileExists() && getUserData().role == 'admin')
      );
    }

    // Team membership check: Non-admins must be in the teamspaceIds array
    function isMember(teamspaceId) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;
      return userProfileExists() && 
             (teamspaceId in getUserData().teamspaceIds);
    }

    // -- Collection Rules --

    // User Profiles: All signed-in staff can see profiles for assignment dropdowns
    // Explicit read permission at the document level ensures collection queries work
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Products: Global catalog readable by all authenticated staff
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspaces and nested data
    match /teamspaces/{teamspaceId} {
      // Direct access to the teamspace document
      allow get: if isMember(teamspaceId);
      
      // Global listing of teamspaces is admin-only
      allow list: if isAdmin();
      
      // Manage teamspaces
      allow create, update, delete: if isAdmin();

      // ALL sub-collections (leads, deals, tasks, etc.)
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}
