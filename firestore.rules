rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ UNCONDITIONAL EXECUTIVE MASTER-KEY 🛡️
    // Bypasses all document-read limits and race conditions for leadership.
    // Prioritizes token-based identity for zero-latency access.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1'
      );
    }

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && data != null && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- COLLECTION GROUP RULES (Required for Global Dashboard) --
    
    match /{path=**}/leads/{leadId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/deals/{dealId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/contacts/{contactId} {
      allow read: if isAdmin();
    }

    // -- CORE DOMAIN RULES --

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        userId == request.auth.uid ||
        (getUserData().role == 'sales_team_lead' && (
            resource == null || resource.data.createdBy == request.auth.uid
        ))
      );
      
      allow write: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{leadId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          request.auth.uid in resource.data.assignedToIds
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          getUserData().role == 'sales_team_lead' || 
          request.auth.uid in resource.data.assignedToIds
        );
      }

      match /deals/{dealId} {
        allow read: if isMember(teamspaceId) && (
          isAdmin() || 
          resource.data.teamLeadId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid
        );
        
        allow write: if isMember(teamspaceId) && (
          isAdmin() || 
          resource.data.teamLeadId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid
        );
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}