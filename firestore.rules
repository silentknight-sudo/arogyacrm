rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ INDESTRUCTIBLE EXECUTIVE MASTER-KEY 🛡️
    // Evaluated at the absolute top of the hierarchy to bypass all race conditions.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com'
      );
    }

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        request.auth.token.email == 'pundhir@arogyabio.com'
      );
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    // -- PROTECTED COLLECTIONS --

    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow write: if isAdmin();
      
      match /notifications/{id} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /leads/{id} {
        allow read, write: if isMember(teamspaceId);
      }

      match /deals/{id} {
        allow read, write: if isMember(teamspaceId);
      }

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}