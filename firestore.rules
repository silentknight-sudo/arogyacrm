rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin';
    }

    function isTeamLead() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'sales_team_lead';
    }

    function isTeamspaceMember(teamspaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().teamspaceIds.hasAny([teamspaceId]);
    }

    // Check if the user is the owner or assigned to a specific document
    function isDocOwner(doc) {
      return isOwner(doc.data.ownerId)
          || isOwner(doc.data.assignedToId)
          || (doc.data.assignedToIds != null && request.auth.uid in doc.data.assignedToIds)
          || isOwner(doc.data.organizerId)
          || isOwner(doc.data.callerId)
          || isOwner(doc.data.uploadedById)
          || isOwner(doc.data.requestedById)
          || isOwner(doc.data.processedById)
          || isOwner(doc.data.userId);
    }
    
    // Check if the user making the request will be the owner of the new document
    function isIncomingDocOwner() {
        let data = request.resource.data;
        return data.ownerId == request.auth.uid
            || data.assignedToId == request.auth.uid
            || (data.assignedToIds != null && request.auth.uid in data.assignedToIds)
            || data.organizerId == request.auth.uid
            || data.callerId == request.auth.uid
            || data.uploadedById == request.auth.uid
            || data.requestedById == request.auth.uid
            || data.processedById == request.auth.uid
            || data.userId == request.auth.uid;
    }
    
    function salesExecAllowedLeadUpdateKeys() {
        return ['status', 'notes', 'priority', 'reasoning', 'score', 'engagementScore', 'lastContacted', 'updatedAt'];
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // User profiles: All signed-in users can read profiles to see colleagues.
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Products are public to all signed-in users, but only managed by admins
    match /products/{productId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
    }

    // Teamspaces: Members can read. Admins manage.
    match /teamspaces/{teamspaceId} {
      allow get: if isTeamspaceMember(teamspaceId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().teamspaceIds.hasAny([teamspaceId]));
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || isOwner(resource.data.ownerId);

      // Lead-specific rules for distribution workflow
      match /leads/{leadId} {
        allow get, list: if isTeamspaceMember(teamspaceId) || isAdmin();
        allow create: if (isTeamspaceMember(teamspaceId) || isAdmin()) && (isAdmin() || isTeamLead() || request.auth.uid in request.resource.data.assignedToIds);
        allow update: if 
            (isTeamspaceMember(teamspaceId) || isAdmin()) && (
                isAdmin() || isTeamLead() ||
                (request.auth.uid in resource.data.assignedToIds && 
                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(salesExecAllowedLeadUpdateKeys()))
            );
        allow delete: if (isTeamspaceMember(teamspaceId) || isAdmin()) && (isDocOwner(resource) || isAdmin() || isTeamLead());
      }

      // Generic rule for all other teamspace subcollections.
      match /{collection}/{docId} {
        allow get, list: if isTeamspaceMember(teamspaceId) || isAdmin();
        allow create: if (isTeamspaceMember(teamspaceId) || isAdmin()) && isIncomingDocOwner();
        allow update, delete: if (isTeamspaceMember(teamspaceId) || isAdmin()) && (isDocOwner(resource) || isAdmin());
      }
    }
  }
}