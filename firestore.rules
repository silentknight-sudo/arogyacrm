rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ INDESTRUCTIBLE EXECUTIVE MASTER-KEY 🛡️
    // This allows specific users total access based on token identity.
    // Absolute prioritization at the root prevents rule shadowing.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == 'admin@arogyabio.com' ||
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.uid == '3oC7dLZCUsRpwNEPWlokfSGTmnx1' ||
        request.auth.uid == '9E06P0PsRtgyS5H60weu42iE0zH2'
      );
    }

    // -- ATOMIC HELPERS --

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && (
        data.role == 'admin' || 
        request.auth.token.email == 'pundhir@arogyabio.com' ||
        request.auth.token.email == 'admin@arogyabio.com'
      );
    }

    function isMember(teamspaceId) {
      let data = getUserData();
      return isSignedIn() && (
        data.role == 'admin' || 
        (data.teamspaceIds != null && teamspaceId in data.teamspaceIds)
      );
    }

    function sharesAnyTeamspaceWithUser(userData) {
      let currentUserData = getUserData();
      return isSignedIn() &&
        currentUserData.teamspaceIds != null &&
        userData.teamspaceIds != null &&
        userData.teamspaceIds.size() > 0 &&
        currentUserData.teamspaceIds.hasAny(userData.teamspaceIds);
    }

    // -- CORE RULES --

match /users/{userId} {
  allow read: if isSignedIn() && (
    isAdmin() ||
    userId == request.auth.uid ||
    sharesAnyTeamspaceWithUser(resource.data)
  );
  allow write: if isAdmin();

  match /notifications/{notificationId} {
    allow read, write: if isSignedIn() && userId == request.auth.uid;
  }
}

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamspaces/{teamspaceId} {
      allow get, list: if isMember(teamspaceId);
      allow write: if isAdmin();

      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}
