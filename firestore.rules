rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Base Helpers --
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to get the current user's profile document safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if the user profile exists
    function userProfileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // -- Role & Membership Checks --
    function isAdmin() {
      return isSignedIn() && userProfileExists() && getUserData().role == 'admin';
    }

    function isMember(teamspaceId) {
      return isSignedIn() && userProfileExists() && (
        getUserData().role == 'admin' || 
        getUserData().teamspaceIds.hasAny([teamspaceId])
      );
    }

    // -- Collection Rules --

    // User Profiles: All team members can see each other for assignments/dropdowns
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products: Globally readable by the team
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspaces: Access controlled by membership
    match /teamspaces/{teamspaceId} {
      allow get: if isMember(teamspaceId);
      allow list: if isAdmin(); // Non-admins access teamspaces via individual getDoc in AppProvider
      allow create, update, delete: if isAdmin();

      // Catch-all for all sub-collections within a teamspace
      match /{collection}/{docId} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}