rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --

    // Check if the request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get user profile data
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Check if user profile exists
    function userProfileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Admin check: Prioritizes token claim for performance, falls back to document check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' || 
        (userProfileExists(request.auth.uid) && getUserData(request.auth.uid).role == 'admin')
      );
    }

    // Team membership check: Non-admins must be in the teamspaceIds array
    function isMember(teamspaceId) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;
      return userProfileExists(request.auth.uid) && 
             teamspaceId in getUserData(request.auth.uid).teamspaceIds;
    }

    // -- Collection Rules --

    // User Profiles: All signed-in staff can see profiles for assignment dropdowns
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Products: Global catalog readable by all authenticated staff
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teamspaces and nested data
    match /teamspaces/{teamspaceId} {
      // Direct access to the teamspace document
      allow get: if isMember(teamspaceId);
      
      // Global listing of teamspaces is admin-only (staff fetch teams individually)
      allow list: if isAdmin();
      
      // Manage teamspaces
      allow create, update, delete: if isAdmin();

      // ALL sub-collections (leads, deals, tasks, etc.)
      // Recursive wildcard ensures consistent protection across all depths
      match /{allPaths=**} {
        allow read, write: if isMember(teamspaceId);
      }
    }
  }
}